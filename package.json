{
  "name": "tong-mon-8d",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "generate:art": "python3 packages/art-tools/build_assets.py",
    "generate:art:force": "python3 packages/art-tools/build_assets.py --force",
    "verify:assets": "node --import tsx packages/art-tools/verify_manifest.ts",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:doc-sync": "node scripts/verify-doc-sync.mjs",
    "package:assets": "node scripts/package-runtime-assets.mjs",
    "build:shared": "npm run build --workspace=@tong-mon-8d/shared",
    "build:data": "npm run build --workspace=@tong-mon-8d/game-data",
    "build:server": "npm run build --workspace=@tong-mon-8d/server",
    "build:client": "npm run build --workspace=@tong-mon-8d/client",
    "build": "npm run verify:assets && npm run verify:architecture && npm run build:shared && npm run build:data && npm run build:server && npm run build:client",
    "typecheck": "tsc -b packages/shared packages/game-data apps/server apps/client",
    "dev:server": "npm run dev --workspace=@tong-mon-8d/server",
    "dev:client": "npm run dev --workspace=@tong-mon-8d/client",
    "dev": "concurrently -k -n SERVER,CLIENT \"npm run dev:server\" \"npm run dev:client\"",
    "test": "vitest run --testTimeout=15000",
    "test:sim": "node --import tsx packages/game-data/src/runSimulation.ts",
    "test:e2e": "node --import tsx tests/e2e/runPlaytest.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "concurrently": "9.1.2",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vite": "6.2.2",
    "vitest": "3.0.9"
  }
}
